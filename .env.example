# Copy values from Supabase Dashboard > Connect > Transaction pooler.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@POOLER_HOST:6543/postgres

# Generate a long, random value. Never commit the actual secret.
SESSION_SECRET=replace-with-a-long-random-secret

# Set separate, strong administrator credentials.
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Use production when deployed to enable Secure cookies.
NODE_ENV=development
